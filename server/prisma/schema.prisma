// ============================================
// NIVA — Database Schema (Prisma)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Users & Auth ---

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  displayName   String?
  avatarUrl     String?
  pin           String?   // Optional PIN for quick unlock
  faceVerified  Boolean   @default(false) // Verified real human via Face ID
  twoFactorSecret String? // TOTP secret for 2FA
  twoFactorEnabled Boolean @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  devices        Device[]
  conversations Conversation[]
  memories      Memory[]
  documents     Document[]
  permissions   Permission[]
  workflows     Workflow[]
  auditEvents   AuditEvent[]

  @@map("users")
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  deviceId    String?
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@map("sessions")
}

model Device {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String   // web, desktop, mobile
  fingerprint String?
  lastSeenAt  DateTime @default(now())
  isTrusted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("devices")
}

// --- Conversations & Messages ---

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("New Conversation")
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // user, assistant, system, tool
  content        String
  metadata       Json?    // tool calls, attachments, etc.
  tokenCount     Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// --- Memory & RAG ---

model Memory {
  id        String   @id @default(uuid())
  userId    String
  key       String
  content   String
  category  String   @default("general") // general, preference, fact, instruction
  embedding Float[]  @default([]) // Vector embedding for semantic search
  isPinned  Boolean  @default(false)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("memories")
}

model Document {
  id          String   @id @default(uuid())
  userId      String
  filename    String
  mimeType    String
  sizeBytes   Int
  content     String?  // Full extracted text
  metadata    Json?
  createdAt   DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  chunkIndex Int
  embedding  Float[]  @default([]) // Vector embedding
  metadata   Json?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

// --- Security & Permissions ---

model Permission {
  id        String   @id @default(uuid())
  userId    String
  resource  String   // tool, feature, module
  action    String   // use, read, write, execute, admin
  isGranted Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action])
  @@map("permissions")
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String?
  details   Json?
  ipAddress String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_events")
}

// --- Automation & Jobs ---

model Workflow {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  trigger     Json     // { type: 'schedule' | 'event' | 'manual', config: {} }
  steps       Json     // Array of step definitions
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@map("workflows")
}

model Job {
  id         String   @id @default(uuid())
  workflowId String?
  type       String   // generation, communication, automation
  status     String   @default("pending") // pending, running, completed, failed, cancelled
  input      Json?
  output     Json?
  error      String?
  attempts   Int      @default(0)
  maxRetries Int      @default(3)
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime @default(now())

  workflow Workflow? @relation(fields: [workflowId], references: [id])

  @@map("jobs")
}

// --- Communication ---

model Integration {
  id          String   @id @default(uuid())
  name        String   // email, sms, whatsapp, etc.
  provider    String
  config      Json     // Encrypted provider config
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actions CommunicationAction[]

  @@map("integrations")
}

model CommunicationAction {
  id            String   @id @default(uuid())
  integrationId String
  type          String   // send_email, send_message, make_call
  recipient     String
  content       String?
  status        String   @default("pending")
  metadata      Json?
  authorizedBy  String?  // user confirmation reference
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id])

  @@map("communication_actions")
}
