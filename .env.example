# ============================================
# NIVA — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# --- Server ---
NODE_ENV=development
SERVER_PORT=3001
CLIENT_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_USER=niva
POSTGRES_PASSWORD=niva_dev_password
POSTGRES_DB=niva_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# --- Authentication ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- AI Providers ---
# Google Gemini (Primary — get key at https://aistudio.google.com)
GEMINI_API_KEY=

# OpenAI (Optional)
OPENAI_API_KEY=

# Ollama (Optional — local AI, default http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# --- Voice ---
# Google Cloud TTS/STT (Optional, Web Speech API used as fallback)
GOOGLE_CLOUD_TTS_KEY=
GOOGLE_CLOUD_STT_KEY=

# --- Communication ---
# SMTP Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Security ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=change-this-to-another-random-string
